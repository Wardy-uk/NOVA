# =============================================================================
# N.O.V.A — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.
# =============================================================================

# --- Server ---
PORT=3001
NODE_ENV=development
# DATA_DIR=              # Override data directory (default: project root)
# FRONTEND_URL=http://localhost:5173   # Set in dev for SSO callback redirect

# --- Authentication ---
# JWT_SECRET=            # Override JWT secret (default: from settings.json)

# --- Jira (seeds settings.json on first run) ---
# JIRA_URL=https://your-instance.atlassian.net
# JIRA_PERSONAL_TOKEN=

# --- Microsoft Graph / Entra SSO ---
# (SSO config is managed in NOVA Admin > Integrations)

# --- Monday.com (seeds settings.json on first run) ---
# MONDAY_API_TOKEN=
# MONDAY_BOARD_IDS=

# --- OpenAI ---
# OPENAI_API_KEY=

# --- Dynamics 365 ---
# D365_ORG_URL=https://your-org.crm11.dynamics.com

# --- NUERO Bridge ---
# NEURO_BRIDGE_SECRET=   # Shared secret for Pi-to-NOVA internal API

# --- Training Export ---
# TRAINING_EXPORT_TOKEN= # Bearer token for /api/training-export endpoint

# --- Delivery Sheet ---
# DELIVERY_XLSX_PATH=    # Override path to Delivery sheet Master.xlsx

# --- OneDrive Watch ---
# ONEDRIVE_WATCH_DIR=    # Override OneDrive sync folder path

# =============================================================================
# Future (WP-01+): Azure SQL + Key Vault
# =============================================================================
# NOVA_SQL_CONNECTION=   # Azure SQL connection string (replaces daypilot.db)
# KEYVAULT_URI=          # Azure Key Vault URI (replaces settings.json secrets)
# ANTHROPIC_API_KEY=     # Claude API key (WP-03: LLM service layer)
