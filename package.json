{
  "name": "daypilot",
  "version": "1.1.491",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "cd nova-mcp && npm run build && cd .. && vite build && vite build --config vite.widget.config.ts && tsc -p tsconfig.server.json",
    "build:widget": "vite build --config vite.widget.config.ts",
    "start": "node dist/server/server/index.js",
    "db:reset": "tsx src/server/db/schema.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@azure/msal-node": "^3.8.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.2.1",
    "gpt-tokenizer": "^3.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.2",
    "mssql": "^12.2.0",
    "nodemailer": "^8.0.1",
    "openai": "^6.22.0",
    "pdf-parse": "^1.1.1",
    "react-chartjs-2": "^5.3.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^9.1.9",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.9.0"
  }
}
